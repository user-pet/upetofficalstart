rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    function safeImage() {
      return request.resource.contentType.matches('^image/(jpeg|png|webp|gif|avif)$');
    }
    function safeVideo() {
      return request.resource.contentType.matches('^video/(mp4|webm|quicktime)$');
    }
    function safeAudio() {
      return request.resource.contentType.matches('^audio/(mpeg|mp3|wav|x-wav|ogg|mp4|x-m4a|aac|flac|x-flac|webm|opus)$');
    }
    function validAsset(fileName) {
      return (fileName.matches('^(avatar|cursor|cover)-[a-zA-Z0-9-]+\\.(jpg|jpeg|png|webp|gif|avif)$')
        && safeImage()
        && request.resource.size <= 5 * 1024 * 1024)
        || (fileName.matches('^(banner|image)-[a-zA-Z0-9-]+\\.(jpg|jpeg|png|webp|gif|avif)$')
        && safeImage()
        && request.resource.size <= 10 * 1024 * 1024)
        || (fileName.matches('^audio-[a-zA-Z0-9-]+\\.(mp3|wav|ogg|m4a|aac|flac|webm|opus)$')
        && safeAudio()
        && request.resource.size <= 20 * 1024 * 1024)
        || (fileName.matches('^click-[a-zA-Z0-9-]+\\.(mp3|wav|ogg|m4a|aac|flac|webm|opus)$')
        && safeAudio()
        && request.resource.size <= 5 * 1024 * 1024)
        || (fileName.matches('^(background|video)-[a-zA-Z0-9-]+\\.(jpg|jpeg|png|webp|gif|avif|mp4|webm|mov)$')
        && (safeImage() || safeVideo())
        && request.resource.size <= 100 * 1024 * 1024);
    }
    match /profiles/{uid}/{fileName} {
      allow get: if true;
      allow list: if request.auth != null && request.auth.uid == uid;
      allow create, update: if request.auth != null
        && request.auth.uid == uid
        && request.auth.token.email_verified == true
        && validAsset(fileName);
      allow delete: if request.auth != null && request.auth.uid == uid;
    }
  }
}
