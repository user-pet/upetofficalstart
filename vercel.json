{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "rewrites": [
    { "source": "/.well-known/discord", "destination": "/api/well-known-discord" },
    { "source": "/:username/.well-known/discord", "destination": "/api/well-known-discord?user=:username" },
    { "source": "/(.*)", "destination": "/index.html" }
  ],
  "crons": [{ "path": "/api/visitor-prune", "schedule": "0 0 * * *" }]
}
